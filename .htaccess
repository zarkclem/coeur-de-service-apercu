# Configuration Apache de l'hébergement OVH (SECURITE.md §2). À vérifier après le premier déploiement :
# mod_headers, mod_rewrite et mod_deflate actifs, en-têtes reçus (Mozilla Observatory).

Options -Indexes
ServerSignature Off
ErrorDocument 404 /404.html

# --- Redirections : HTTPS obligatoire et domaine sans « www » (une seule adresse canonique) ---
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteCond %{HTTP_HOST} ^(?:www\.)?(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# --- En-têtes de sécurité ---
<IfModule mod_headers.c>
  # HSTS : sans « preload » tant que le HTTPS n'est pas validé en production (SECURITE.md §2)
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set X-Frame-Options "DENY"
  # Complète la CSP <meta> générée par Astro (scripts, styles, sources) avec les directives
  # qu'une balise <meta> ne peut pas porter. Pas de default-src ici : il bloquerait les empreintes d'Astro.
  Header always set Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'self'"
  Header unset X-Powered-By
</IfModule>

# --- Cache : fichiers versionnés d'Astro (nom contenant une empreinte) gardés un an ---
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|avif|webp|png|jpg|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# --- Compression ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

# --- Fichiers qui ne doivent jamais être servis ---
<FilesMatch "(^\.|\.(md|yaml|yml|json|lock|log|sh|ini|env)$)">
  Require all denied
</FilesMatch>
